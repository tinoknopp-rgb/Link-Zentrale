<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="10dp" android:background="#E60A2540">
    <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="🔗 Link-Zentrale" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
    <TextView android:id="@+id/w_count" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="4dp" android:paddingBottom="6dp" android:text="💬 …" android:textColor="#8FD3FF" android:textSize="14sp" />
    <TextView android:id="@+id/w_share" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="#25D366" android:gravity="center" android:padding="8dp"
        android:text="📤 Test-Links teilen" android:textColor="#06301A" android:textSize="14sp" android:textStyle="bold" />
</LinearLayout>
